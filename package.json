{
  "name": "validador-domicilios",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Prototipo: validar un domicilio contra fuentes oficiales (Georef) e informar hasta qué nivel se pudo validar.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    }
  },
  "files": [
    "dist-lib"
  ],
  "sideEffects": false,
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "build:lib": "node -e \"require('fs').rmSync('dist-lib',{recursive:true,force:true})\" && tsc -p tsconfig.lib.json",
    "prepare": "npm run build:lib",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --build"
  },
  "devDependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@material-symbols/font-400": "^0.48.2",
    "@openvue/themes": "^1.1.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^21.0.4",
    "maplibre-gl": "^6.11.1",
    "openvue": "^1.1.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
